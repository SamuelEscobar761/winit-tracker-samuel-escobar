# replica = Chromium on a local copy of the portal (default), mock = in-process fixtures, live = real portal
CAP_PROVIDER=replica
MOCK_FAILURE_RATE=0.08
REPLICA_CAPTCHA_RATE=0.1
WEB_PORT=8080

# Required when CAP_PROVIDER=live
# ADMIN_TOKEN=

# Set to true when the app is served over HTTPS
COOKIE_SECURE=false

MAX_WORKERS=3
CAP_ACTION_DELAY_SECONDS=5
CAP_MAX_ACTIONS_PER_MINUTE=12

AI_ENABLED=false
AI_OFFLINE_MOCK=false
AI_MODEL=claude-opus-5-5
AI_RULES_AUTO_APPLY=true
# ANTHROPIC_API_KEY=
