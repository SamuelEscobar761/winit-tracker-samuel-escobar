# mock = in-process fixtures, replica = Chromium on a local copy of the portal, live = real portal
CAP_PROVIDER=mock
MAX_WORKERS=3

CAP_ACTION_DELAY_SECONDS=5
CAP_MAX_ACTIONS_PER_MINUTE=12
# CAP_GLOBAL_MAX_ACTIONS_PER_MINUTE=
# CAP_MAX_DETAILS_PER_PERSON=

SEARCH_TIMEOUT_SECONDS=60
DETAIL_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=2
MAX_CASES_PER_PERSON=500

CAPTCHA_WAIT_SECONDS=300
CAP_DOWN_RECHECK_SECONDS=30
DEFAULT_PARALLELISM=1
SSE_HEARTBEAT_SECONDS=15

CSV_MAX_BYTES=2000000
CSV_MAX_ROWS=1000

CAP_BASE_URL=https://cap.sb-court.org/traffic
LIVE_HEADLESS=true
LIVE_NO_SANDBOX=false
LIVE_RESPONSE_TIMEOUT_SECONDS=25

MOCK_FIXTURES_DIR=fixtures
MOCK_SPEED_FACTOR=10
MOCK_FAILURE_RATE=0.08
# MOCK_SEED=
REPLICA_CAPTCHA_RATE=0.1

NAME_VARIANTS_FILE=config/name_variants.json

SESSION_TTL_SECONDS=28800
COOKIE_SECURE=true
LOGIN_MAX_FAILURES_PER_MINUTE=5

SCREENCAST_QUALITY=60
SCREENCAST_EVERY_NTH_FRAME=2
SCREENCAST_MAX_WIDTH=1024

CORS_ORIGINS=["http://localhost:5173"]

# Required when CAP_PROVIDER=live
# ADMIN_TOKEN=

AI_ENABLED=false
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_OFFLINE_MOCK=false
AI_MAX_OUTPUT_TOKENS=4000
AI_REQUEST_TIMEOUT_SECONDS=60
AI_RULES_AUTO_APPLY=true
AI_RULES_MAX_REPAIRS_PER_HOUR=3
PORTAL_RULES_DIR=config
